# -----------------------------------------------------------------------------
# Node.js
# -----------------------------------------------------------------------------
/node_modules
/dist
/build
/out

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS and Editor Files
.DS_Store
Thumbs.db

# Environment variables (Critical: NEVER commit these!)
.env
.env.*
.env.local

# Dependency managers cache files
.npm
.eslintcache

# TypeScript
# Compiled JavaScript files from TypeScript source
*.js.map
*.d.ts
/ts-output/

# -----------------------------------------------------------------------------
# Google Apps Script (.gs)
#
# NOTE: The .gs files themselves (your source code) should be tracked.
# The following ignores are for files created by local tools like 'clasp'.
# -----------------------------------------------------------------------------

# Google Apps Script configuration file (contains script ID)
.clasp.json

# Authorization/Credentials cache (Critical: NEVER commit these!)
# This is usually a JSON file or a token directory generated by 'clasp'
# or other Google auth tools during login.
credentials.json
.tokens/